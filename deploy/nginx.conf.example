# Replace origin.example.com and TLS paths with a certificate valid for your
# EC2 origin hostname. Do not treat browser->CloudFront TLS as origin encryption.
server {
    listen 443 ssl;
    server_name origin.example.com;
    ssl_certificate /etc/ssl/intellimart/fullchain.pem;
    ssl_certificate_key /etc/ssl/intellimart/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;

    # Configure CloudFront to send this secret header and restrict the security
    # group to CloudFront origin-facing IP ranges. Replace the placeholder.
    if ($http_x_intellimart_origin != "REPLACE_WITH_RANDOM_ORIGIN_HEADER") {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
