# Copy to .env. Demo runs with no AWS resources or credentials.
INTELLIMART_MODE=demo
INTELLIMART_DEMO_ADMIN=true
INTELLIMART_DATA_FILE=.data/application.json
# Legacy catalogue edits are imported on the first application-data write.
INTELLIMART_DEMO_DATA_FILE=.data/catalogue.json
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
AWS_REGION=ap-south-1

# For cloud mode set INTELLIMART_MODE=cloud, INTELLIMART_DEMO_ADMIN=false,
# APP_URL=https://YOUR-DISTRIBUTION.cloudfront.net, and all fields below.
# One DynamoDB table: partition key PK (String), sort key SK (String).
# No secondary index is required for this bounded college-lab data model.
DYNAMODB_TABLE=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ADMIN_GROUP=admin
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep stable across restarts; rotating it signs all customers out.
SESSION_SECRET=
S3_MEDIA_BUCKET=
# CloudFront S3 origin serves /media/*; keep /uploads/* private/unroutable.
MEDIA_BASE_URL=
# Verify this sender and demo recipient emails in SES sandbox (Mumbai).
SES_FROM_EMAIL=

# Preferred: Secrets Manager secret containing JSON
# {"keyId":"rzp_test_...","keySecret":"...","webhookSecret":"..."}
RAZORPAY_SECRET_ID=
# Alternative: server-only environment values. Do NOT populate both sources.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_RESERVATION_MINUTES=30

# No long-lived AWS credentials are required on EC2: attach the supplied IAM role.
# Local cloud testing can use AWS_PROFILE after configuring AWS CLI / SSO.
# AWS_PROFILE=intellimart
# For temporary credentials only, if your account requires them:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# NEVER use VITE_* for any secret. Never commit .env or paste keys in chat.
